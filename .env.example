# Copy this file to .env and fill in your own values. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local development without PostgreSQL: set USE_SQLITE=True (final submission: False)
USE_SQLITE=False

# PostgreSQL (local) or Supabase (copy the values from your project's database settings)
DB_NAME=buildhub
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432
# Use "require" for Supabase, "prefer" for a local PostgreSQL
DB_SSLMODE=prefer
